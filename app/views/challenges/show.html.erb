<div class="container my-5">
  
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 border-bottom pb-3">
    <h1 class="display-5 fw-bold text-dark mb-0"><%= @challenge.name %></h1>
    
    <div class="d-flex gap-2">
      <% if current_user && @challenge.creator_id == current_user.id %>
        <%= link_to " Edit Challenge", edit_challenge_path(@challenge), class: "btn btn-outline-dark" %>
        <%= button_to " Delete Challenge", challenge_path(@challenge),
                      method: :delete,
                      data: { confirm: "Are you sure you want to delete this challenge?" },
                      class: "btn btn-outline-danger" %>
      <% end %>
      
      <% if current_user %>
        <% if @participation %>
          <%= button_to "Leave Challenge",
                        challenge_challenge_participation_path(@challenge, @participation),
                        method: :delete,
                        class: "btn btn-outline-secondary" %>
        <% else %>
          <%= button_to "Join Challenge",
                        challenge_challenge_participations_path(@challenge),
                        method: :post,
                        class: "btn btn-dark btn-lg" %>
        <% end %>
      <% else %>
        <div class="alert alert-info py-2 px-3 mb-0">Sign in to join this challenge.</div>
      <% end %>
    </div>
  </div>

  <div class="card mb-5 shadow-sm border-light">
    <div class="card-body">
      <h5 class="card-title fw-bold mb-3 text-secondary">Challenge Details</h5>
      
      <div class="mb-4">
        <p class="fw-bold mb-1 text-dark">Description:</p>
        <div class="text-muted"><%= simple_format(@challenge.description) %></div>
      </div>
      
      <div class="row row-cols-md-3 g-3">
        <div>
          <span class="small fw-bold text-muted">Category:</span>
          <p class="mb-0 text-dark"><%= @challenge.category.name %></p>
        </div>
        <div>
          <span class="small fw-bold text-muted">Visibility:</span>
          <p class="mb-0 text-dark"><%= @challenge.visibility.titleize %></p>
        </div>
        <div>
          <span class="small fw-bold text-muted">Status:</span>
          <span class="badge bg-primary"><%= @challenge.status.titleize %></span>
        </div>
      </div>
      
      <hr class="my-3">
      
      <div class="row">
        <div class="col-12">
          <span class="small fw-bold text-muted">Duration:</span>
          <p class="mb-0 text-dark">
            <%= l(@challenge.start_date, format: :long) %> — <%= l(@challenge.end_date, format: :long) %>
          </p>
        </div>
      </div>
    </div>
  </div>
  
  <div class="card mb-5 shadow-sm border-light">
    <div class="card-body">
      <h5 class="card-title fw-bold mb-3 text-secondary">Access & Requests</h5>
      
      <% if current_user.nil? %>
        <p class="mb-0 text-muted">Sign in to request access to this challenge.</p>
      <% elsif @challenge.creator_id == current_user.id %>
        <p class="mb-0 alert alert-success py-2">You are the **creator** of this challenge.</p>
      <% elsif @challenge_request.present? %>
        <div class="alert alert-info mb-3">
          <strong>Request sent:</strong> Status **<%= @challenge_request.status.capitalize %>**
          <% if @challenge_request.decided_by.present? %>
            &nbsp;·&nbsp; Decided by **<%= @challenge_request.decided_by.username %>**
          <% end %>
        </div>
      <% else %>
        <%= form_with url: challenge_challenge_requests_path(@challenge), method: :post, local: true do |f| %>
          <div class="mb-3">
            <%= f.label :message, "Message for the Creator (Optional)", class: "form-label small fw-bold text-muted" %>
            <%= f.text_area :message, rows: 3, class: "form-control", name: "challenge_request[message]" %>
          </div>
          <%= f.submit "Request Access", class: "btn btn-outline-dark" %>
        <% end %>
      <% end %>
      
      <% if @user_requests.any? && @challenge.creator_id == current_user.id %> 
        <hr>
        <h6 class="fw-bold text-secondary">Pending Requests</h6>
        <ul class="list-group list-group-flush">
          <% @user_requests.each do |request| %>
            <li class="list-group-item d-flex justify-content-between flex-wrap gap-2 px-0">
              <span>
                <strong><%= request.status.capitalize %></strong>
                &nbsp;·&nbsp; Requested <%= l(request.created_at, format: :short) %>
              </span>
              <% if request.decided_by %>
                <span class="text-muted small">Decided by <%= request.decided_by.username %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>

  <ul class="nav nav-tabs nav-fill border-bottom-0" role="tablist">
    <li class="nav-item" role="presentation">
      <a class="nav-link active text-dark" href="#participants" data-bs-toggle="tab">Participants</a>
    </li>
    <li class="nav-item" role="presentation">
      <a class="nav-link text-dark" href="#progress" data-bs-toggle="tab">Progress Logs</a>
    </li>
    <li class="nav-item" role="presentation">
      <a class="nav-link text-dark" href="#comments" data-bs-toggle="tab">Comments</a>
    </li>
  </ul>

  <div class="tab-content pt-4 border border-top-0 p-4 bg-light shadow-sm">
    <div class="tab-pane fade show active" id="participants" role="tabpanel">
      <%= render partial: "challenge_participations/list", locals: { participations: @participations, challenge: @challenge } %>
    </div>
    <div class="tab-pane fade" id="progress" role="tabpanel">
      <%= render partial: "progress_logs/section", locals: { challenge: @challenge, progress_logs: @progress_logs, progress_log: @progress_log, can_log_progress: @can_log_progress } %>
    </div>
    <div class="tab-pane fade" id="comments" role="tabpanel">
      <%= render partial: "challenge_comments/section", locals: { challenge: @challenge, comments: @comments, comment: @comment } %>
    </div>
  </div>
</div>
