<div class="container my-5">
  
  <div class="row mb-4">
    <div class="col-12 text-center">
      <h1 class="display-6 fw-bold text-dark mb-0">Challenges Hub</h1>
    </div>
  </div>

  <% if current_user %>
    <div class="text-end mb-4">
      <%= link_to "➕ Create New Challenge", new_challenge_path, class: "btn btn-dark" %>
    </div>
  <% end %>

  <%= form_with url: challenges_path, method: :get, local: true, class: "card card-body mb-5 shadow-sm border-light bg-light" do |f| %>
    <h5 class="card-title mb-3 text-secondary">Filter Challenges</h5>
    <div class="row g-3 align-items-end">
      
      <div class="col-md-4">
        <%= f.label :category_id, "Category", class: "form-label small fw-bold text-muted" %>
        <%= f.select :category_id,
                      options_for_select([["All", nil]] + @categories.map { |c| [c.name, c.id] }, @filters[:category_id]),
                      {},
                      class: "form-select form-select-sm border-secondary" %>
      </div>
      
      <div class="col-md-4">
        <%= f.label :visibility, "Visibility", class: "form-label small fw-bold text-muted" %>
        <%= f.select :visibility,
                      options_for_select([["All", nil]] + @visibilities.map { |v| [v.titleize, v] }, @filters[:visibility]),
                      {},
                      class: "form-select form-select-sm border-secondary" %>
      </div>
      
      <div class="col-md-4">
        <%= f.label :status, "Status", class: "form-label small fw-bold text-muted" %>
        <%= f.select :status,
                      options_for_select([["All", nil]] + @statuses.map { |s| [s.titleize, s] }, @filters[:status]),
                      {},
                      class: "form-select form-select-sm border-secondary" %>
      </div>
      
      <div class="col-12 d-flex gap-2 pt-3">
        <%= f.submit "Apply Filters", class: "btn btn-dark btn-sm" %>
        <%= link_to "Clear Filters", challenges_path, class: "btn btn-outline-dark btn-sm" %>
      </div>
    </div>
  <% end %>

  <% if @challenges.any? %>
    <div class="list-group shadow-sm">
      <% @challenges.each do |challenge| %>
        <div class="list-group-item list-group-item-action py-3">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            
            <div>
              <h5 class="mb-1 fw-bold">
                <%= link_to challenge.name, challenge_path(challenge), class: "text-primary text-decoration-none" %>
              </h5>
              
              <div class="small text-secondary mt-1">
                <span class="badge bg-light text-dark me-2">Category: <%= challenge.category.name %></span>
                <span class="badge bg-light text-dark me-2">Visibility: <%= challenge.visibility.titleize %></span>
                
                <% status_class = case challenge.status
                                   when 'active' then 'bg-success'
                                   when 'completed' then 'bg-info'
                                   else 'bg-warning'
                                 end
                %>
                <span class="badge <%= status_class %>"><%= challenge.status.titleize %></span>
              </div>
              
              <div class="small text-muted mt-2">
                  <strong>Duration: </strong> From <%= l(challenge.start_date, format: :short) %> to <%= l(challenge.end_date, format: :short) %>
              </div>
            </div>
            
            <div class="text-end">
                <div class="small text-muted">Created by:</div>
                <span class="fw-bold text-dark"><%= challenge.creator.username %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info text-center shadow-sm">
      No challenges match the selected filters.
    </div>
  <% end %>
</div>
