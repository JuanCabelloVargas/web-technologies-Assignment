<div class="container my-5">
  <div class="row justify-content-center mb-5">
    <div class="col-12 text-center">
      <h1 class="display-6 fw-bold text-dark">Notifications inbox</h1>
    </div>
  </div>


  <% if @notifications.empty? %>
    <div class="alert alert-info text-center shadow-sm mt-5" role="alert">
      You're all caught up! No new notifications.
    </div>
  <% else %>
    <div class="list-group shadow-sm">
      <% @notifications.each do |notification| %>
        
        <div class="list-group-item list-group-item-action py-3 d-flex justify-content-between align-items-center 
             <%= 'bg-light border-dark' unless notification.is_read %>">
          
          <div class="d-flex align-items-center">
            
            <% unless notification.is_read %>
              <span class="badge rounded-pill bg-dark me-3" style="width: 8px; height: 8px;"></span>
            <% else %>
              <span class="me-3" style="width: 8px; height: 8px;"></span> <%# Spacer %>
            <% end %>
            
            <div>
              <h6 class="mb-1 fw-bold <%= 'text-dark' unless notification.is_read %> <%= 'text-muted' if notification.is_read %>">
                <%= link_to notification.title, notification_path(notification), class: "text-decoration-none" %>
              </h6>
              
              <small class="text-muted">
                <%= notification.body.truncate(60) %> 
                <span class="mx-1">·</span> 
                <%= notification.notification_type.capitalize %> 
                <span class="mx-1">·</span> 
                <%= time_ago_in_words(notification.created_at) %> ago
              </small>
            </div>
          </div>
          
          <% unless notification.is_read %>
            <%= link_to "Mark as Read", 
                        mark_as_read_notification_path(notification), 
                        data: { turbo_method: :patch }, 
                        class: "btn btn-sm btn-dark flex-shrink-0" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
