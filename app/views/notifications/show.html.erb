<div class="container my-5">
  
  <%= link_to "← Back to Inbox", notifications_path, class: "btn btn-link text-dark px-0 mb-3" %>

  <div class="card shadow-sm border-light">
    <div class="card-body">
      
      <h1 class="fw-bold text-dark mb-3"><%= @notification.title %></h1>
      
      <p class="lead text-muted"><%= @notification.body %></p>
      
      <hr>

      <div class="row small g-2">
        <div class="col-12">
          <strong class="text-secondary me-2">Type:</strong> 
          <span class="text-dark"><%= @notification.notification_type.capitalize %></span>
        </div>
        
        <div class="col-12">
          <strong class="text-secondary me-2">Status:</strong> 
          <% if @notification.is_read %>
            <span class="badge bg-success">Read</span>
          <% else %>
            <span class="badge bg-warning text-dark">Unread</span>
          <% end %>
        </div>

        <div class="col-12">
          <strong class="text-secondary me-2">Received:</strong> 
          <span class="text-dark"><%= @notification.created_at.strftime("%B %d, %Y at %I:%M %p") %></span>
        </div>
      </div>
    </div>
  </div>
</div>
