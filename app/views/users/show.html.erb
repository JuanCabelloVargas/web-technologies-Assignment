<div class="container my-5">
  
  <%# Basic Header %>
  <h1 class="display-6 fw-bold text-dark mb-4"><%= @user.username %></h1>
  
  <%# Essential Details List %>
  <div class="list-group list-group-flush">
    
    <%# Email %>
    <div class="list-group-item px-0">
      <strong class="text-secondary me-2">Email:</strong> 
      <span class="text-dark"><%= @user.email %></span>
    </div>

    <%# Role %>
    <div class="list-group-item px-0">
      <strong class="text-secondary me-2">Role:</strong> 
      <span class="badge bg-secondary text-capitalize"><%= @user.role %></span>
    </div>
    
    <%# Joined Date %>
    <div class="list-group-item px-0">
      <strong class="text-secondary me-2">Joined:</strong> 
      <span class="text-dark"><%= @user.created_at.strftime("%B %d, %Y") %></span>
    </div>

  </div>
  
  <hr class="my-4">

  <%# Action Button (Edit Profile for self) %>
  <% if current_user == @user %>
    <%= link_to "Edit Profile", edit_user_registration_path, class: "btn btn-outline-dark" %>
  <% end %>
  
  <%= link_to "← Back to Users", users_path, class: "btn btn-link text-dark" %>
</div>
