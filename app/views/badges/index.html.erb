<div class="container my-5">
  <div class="row justify-content-center mb-5">
    <div class="col-12 text-center">
      <h1 class="display-6 fw-bold text-dark">Available challenge badges</h1>
    </div>
  </div>


  <% if @badges.empty? %>
    <div class="alert alert-warning text-center mt-5" role="alert">
      No badges have been created yet.
    </div>
  <% else %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% @badges.each do |badge| %>
        <div class="col">
          <%= link_to badge_path(badge), class: "card card-link text-decoration-none h-100 shadow-sm border-light" do %>
            <div class="card-body p-4 text-center">
              
              <div class="mb-3 d-inline-block rounded-circle p-3 bg-light border border-secondary">
                <span style="font-size: 2.5rem; color: #495057;" title="<%= badge.name %>">🌟</span>
              </div>
              
              <h5 class="card-title text-dark mb-1 fw-bold">
                <%= badge.name %>
              </h5>
              
              <p class="card-text text-muted small mb-3">
                <%= badge.description.truncate(70) %>
              </p>
              
              <small class="text-secondary fw-bold d-block">Code: <%= badge.code %></small>

            </div>
            <div class="card-footer bg-transparent border-0 pt-0 pb-3">
               <small class="text-primary fw-bold">View Details →</small>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

</div>
