<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 text-center">
      
      <div class="mb-4 d-inline-block rounded-circle p-4 bg-dark border border-secondary shadow-lg">
        <span style="font-size: 5rem; color: gold;" title="<%= @badge.name %>"></span> 
      </div>
      
      <h1 class="display-4 fw-bold text-dark mb-2"><%= @badge.name %></h1>
      
      <div class="card card-body shadow-sm border-light mb-4 text-start">
        <h5 class="card-title text-secondary fw-bold mb-3">Reward Details</h5>
        
        <p class="mb-3">
          <strong class="text-dark">Description:</strong> 
          <span class="text-muted"><%= @badge.description %></span>
        </p>
        
        <p class="mb-0">
          <strong class="text-dark">Code:</strong> 
          <span class="badge bg-light text-dark"><%= @badge.code %></span>
        </p>
      </div>

      <div class="d-flex justify-content-center gap-3">
        <%= link_to "← Back to Badges Gallery", badges_path, class: "btn btn-outline-dark" %>
        
        <%= link_to "View Challenges to Earn", challenges_path(badge_id: @badge.id), class: "btn btn-primary" %>
      </div>

      <% if current_user && can?(:manage, @badge) %>
        <div class="mt-4 pt-3 border-top">
          <%= link_to "Edit Badge", edit_badge_path(@badge), class: "btn btn-sm btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
