<div class="container my-5">
  <div class="row mb-5">
    <div class="col-12">
      <h1 class="display-4 fw-bold text-dark mb-2"><%= @category.name %> Challenges</h1>
      <p class="lead text-muted">
        Explore all available challenges focused on <%= @category.name %>.
      </p>
      
      <small class="text-muted d-block mt-3">
        Category created: <%= @category.created_at.strftime("%B %d, %Y") %>
        <% if @category.created_at != @category.updated_at %>
          | Last updated: <%= @category.updated_at.strftime("%B %d, %Y") %>
        <% end %>
      </small>
      
      <%= link_to "← Back to Categories", categories_path, class: "btn btn-link text-dark px-0 mt-3" %>
    </div>
  </div>

  <hr class="my-4">

  <h2 class="mb-4">Available Challenges</h2>

  <% if @category.challenges.empty? %>
    <div class="alert alert-info text-center" role="alert">
      There are currently no challenges listed under the **<%= @category.name %>** category.
    </div>
  <% else %>
    <div class="list-group shadow-sm">
      <% @category.challenges.each do |challenge| %>
        <%= link_to challenge_path(challenge), class: "list-group-item list-group-item-action" do %>
          <div class="d-flex w-100 justify-content-between align-items-center">
            <h5 class="mb-1 fw-bold text-primary"><%= challenge.name %></h5>
            <small class="text-muted"><%= challenge.status.capitalize %></small>
          </div>
          <p class="mb-1 text-truncate"><%= challenge.description.truncate(100) %></p>
          <small class="text-secondary">Starts: <%= challenge.start_date.strftime("%B %d, %Y") %></small>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
